[Unit]
Description=ZONA private Telegram task receiver
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/ZONA
EnvironmentFile=/root/ZONA/.env
ExecStart=/usr/bin/node /root/ZONA/scripts/bridge-bot.js
Restart=on-failure
RestartSec=5
RestartPreventExitStatus=78
TimeoutStopSec=45
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/root/ZONA/data

[Install]
WantedBy=multi-user.target
