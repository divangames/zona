{
  "name": "zonadeck-bot",
  "version": "1.0.0",
  "description": "Telegram-бот: фото кроссовок → название и описание в стиле каталога и референс-сайтов",
  "main": "bot/index.js",
  "scripts": {
    "start": "node bot/index.js",
    "start:prod": "node --no-deprecation bot/index.js",
    "reload-catalog": "node scripts/reload-catalog.js",
    "check-ollama": "node scripts/check-ollama.js",
    "report": "node scripts/send-project-report.js",
    "test:report": "node --test tests/projectReport.test.js tests/installReporting.test.js",
    "report:test": "node scripts/test-reporting.js",
    "report:install": "node scripts/install-reporting.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "cheerio": "^1.0.0",
    "dotenv": "^16.4.7",
    "openai": "^4.77.0",
    "sax": "^1.6.0",
    "telegraf": "^4.16.3"
  }
}
