# Telegram
TELEGRAM_BOT_TOKEN=
# Личный числовой Telegram ID владельца. Сначала отправьте боту /start в личке.
TELEGRAM_OWNER_CHAT_ID=

# YML-каталог (по умолчанию https://outmaxshop.com/yml/all_new.yml)
# PARSER_URL=

# YML-каталог (по умолчанию https://outmaxshop.com/yml/all_new.yml)
# PARSER_URL=

# Группа: обрабатывать любое сообщение (если Group Privacy выключен)
# GROUP_ACCEPT_ALL=1

# AI: ollama (бесплатно, локально) или openai
AI_PROVIDER=ollama

# --- Ollama (по умолчанию) ---
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_VISION_MODEL=llava
OLLAMA_TEXT_MODEL=llama3.2
OLLAMA_TIMEOUT_MS=300000

# --- OpenAI (если AI_PROVIDER=openai) ---
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_VISION_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=

# --- Yandex AI Studio (SEO-новости: /seo, кнопка «SEO-новость») ---
# Ключ и folder ID из console.yandex.cloud / AI Studio
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
